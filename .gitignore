# Ignore dependency caches
/.cxx/
/.externalNativeBuild/
/gradle/
/out/

# Ignore local properties (like SDK paths)
/local.properties

# Ignore Generated Files (APT, DataBinding, etc.)
/.navigation/
/intermediates/
/generated/
/incremental/