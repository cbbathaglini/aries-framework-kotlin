<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/detail_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Cabeçalho -->
        <TextView
            android:id="@+id/connection_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome da conexão"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/teal_700"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/connection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado:"
            android:textSize="16sp"
            android:textColor="@color/gray_700" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/gray_200" />

        <!-- Bloco de detalhes -->
        <TextView android:text="ID da Conexão"
            style="@style/TextLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
        <TextView android:id="@+id/connection_id"
            style="@style/TextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView android:text="DID Remoto"
            style="@style/TextLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView android:id="@+id/connection_did"
            style="@style/TextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView android:text="Criado em"
            style="@style/TextLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView android:id="@+id/connection_date"
            style="@style/TextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView android:text="Thread ID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextLabel" />
        <TextView android:id="@+id/threadId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextValue" />

        <TextView android:text="Label"
            style="@style/TextLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView android:id="@+id/theirLabel"
            style="@style/TextValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Botões -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_did_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copiar DID"
            android:textColor="@color/teal_700"
            app:strokeColor="@color/teal_700"
            android:layout_marginTop="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_proof_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitar Prova"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/view_credentials_button"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver Credenciais Emitidas"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            android:textColor="@color/teal_700"
            app:strokeColor="@color/teal_700" />
    </LinearLayout>
</ScrollView>