<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_50"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/proofContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:text="Proof Information"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:textColor="@color/gray_900"
                    android:paddingBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/proofId"
                    android:text="ID: -"
                    android:paddingVertical="4dp"
                    android:textColor="@color/gray_900"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/connectionId"
                    android:text="Connection: -"
                    android:paddingVertical="4dp"
                    android:textColor="@color/gray_900"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/state"
                    android:text="State: -"
                    android:paddingVertical="4dp"
                    android:textColor="@color/gray_900"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/threadId"
                    android:text="Thread ID: -"
                    android:paddingVertical="4dp"
                    android:textColor="@color/gray_900"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/verified"
                    android:text=""
                    android:paddingVertical="4dp"
                    android:textColor="@color/gray_900"
                    android:textSize="14sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/attributesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Requested Attributes"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/gray_900"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:id="@+id/attributesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/predicatesHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Requested Predicates"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/gray_900"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:id="@+id/predicatesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/nonRevokedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non-Revocation Interval"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/gray_900"
                    android:paddingBottom="8dp" />

                <TextView
                    android:id="@+id/nonRevokedInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start: - | End: -"
                    android:textColor="@color/gray_700"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
