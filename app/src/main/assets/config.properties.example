# =============================================================
# Example configuration template (config.properties.example)
#
# Copy this file to config.properties and fill in your own
# endpoints / addresses. The real config.properties is NOT
# tracked by git (see .gitignore) so internal URLs and keys
# never end up in the repository.
# =============================================================

# --------- Mediators (out-of-band invitations) ---------
# invitation_url=https://example.com/mediator?oob=<your-invitation>
# endpoint=https://example.com/mediator

# --------- Besu network ---------
# "des", "chainId", "nodeAddress" for the target chain
#besu_chainId=1337
#besu_nodeAddress=https://example.com/besu

# --------- Contract addresses (zeroed placeholders) ---------
DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000001
SCHEMA_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000002
CRED_DEF_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000003
REVOCATION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000004

# --------- emulator workaround ---------
# When true, 192.168.x.x is mapped to 10.0.2.2 for local did:webvh resources
emulator=false

# --------- cache ---------
cache.default.ttl.days=1
cache.schema.ttl.days=30
cache.revreg.ttl.days=30
cache.tails.ttl.days=30
